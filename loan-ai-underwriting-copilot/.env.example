# Copy to .env and fill in locally. Never commit real values.

# --- NVIDIA hosted inference -------------------------------------------------
# Required. Read at runtime only; never logged or persisted by this code.
NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
# Verified against GET /v1/models AND a live inference probe (2026-09-16):
# meta/llama-3.3-70b-instruct is not listed; both ~49B-70B Nemotron instruct
# models are listed but return 404 on /chat/completions (deprecated), so the
# default is the strongest model that actually serves inference.
NVIDIA_MODEL=nvidia/nemotron-3-nano-omni-30b-a3b-reasoning
NVIDIA_TEMPERATURE=0.1
NVIDIA_TOP_P=0.9
NVIDIA_MAX_OUTPUT_TOKENS=3000
NVIDIA_REQUEST_TIMEOUT=120
NVIDIA_MAX_RETRIES=3
NVIDIA_RETRY_BACKOFF_SECONDS=2

# Optional multimodal fallback for unreadable documents. Disabled by default.
ENABLE_VISION_FALLBACK=false
NVIDIA_VISION_MODEL=meta/llama-3.2-90b-vision-instruct

# --- Routing thresholds ------------------------------------------------------
AI_CONFIDENCE_THRESHOLD=0.85
PACKET_COMPLETENESS_THRESHOLD=0.90

# --- Dataloop ----------------------------------------------------------------
DATALOOP_PROJECT_ID=37b46e9c-3d18-475d-b624-254d6e5eefd3
SOURCE_DATASET=loan-structured-output
GROUND_TRUTH_DATASET=loan-ground-truth
GROUND_TRUTH_FOLDER=/ai-underwriting-copilot-v1
PIPELINE_NAME=loan-ai-underwriting-copilot-v1
HUMAN_REVIEW_TASK_NAME=loan-ai-underwriting-copilot-v1-human-review
# Used by deployment scripts only (dl.login_api_key / dl.login_m2m)
DATALOOP_API_KEY=

# --- Logging -----------------------------------------------------------------
LOG_LEVEL=INFO
